#!/bin/bash

## Description: Serve the Playwright HTML report and print its URL
## Usage: playwright-report
## Example: "ddev playwright-report"

set -eu

# The Varnish add-on takes over the main hostname, so DDEV routes the web
# container's extra exposed ports only under the "novarnish." hostname.
host="${DDEV_HOSTNAME}"
if getent hosts varnish >/dev/null; then
  host="novarnish.${host}"
fi

echo "Playwright report: https://${host}:9323 (Ctrl+C to stop)"

# Listen on 0.0.0.0 so ddev-router can reach the server. Playwright's own
# "Serving HTML report at http://0.0.0.0:9323" line is an in-container address,
# so hide it to avoid confusion.
cd /var/www/html
npx playwright show-report playwright/report --host 0.0.0.0 --port 9323 "$@" \
  | grep --line-buffered -v "Serving HTML report at"
